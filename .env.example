# ==============================================================================
# Pelvic Rehab PWA - Variables de Entorno (Opcional)
# ==============================================================================
# La aplicación es 100% Offline-First. Si estas variables no se configuran,
# todos los datos se guardan de forma privada en el almacenamiento local del dispositivo (localStorage).
#
# Si deseas sincronizar entre múltiples dispositivos (móvil y PC), crea un proyecto gratuito
# en https://supabase.com y copia aquí tus credenciales:

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-publica
